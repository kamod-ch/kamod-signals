{
  "name": "@kamod-ch/signals",
  "version": "1.1.0",
  "description": "Persisted Preact signals with localStorage, sessionStorage, IndexedDB, cookie, and memory drivers.",
  "keywords": [
    "preact",
    "signals",
    "preact-signals",
    "state-management",
    "persistent-state",
    "localstorage",
    "sessionstorage",
    "reactivity",
    "typescript",
    "vite",
    "kamod"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Klaus Zahiragic <watzak>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/signals.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm test && pnpm typecheck && pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@preact/signals": "^2.0.0",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@preact/signals": "^2.11.3",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "preact": "^11.0.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
