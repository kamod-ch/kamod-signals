{
  "name": "@kamod-ch/signals",
  "version": "0.1.0",
  "description": "Persisted Preact signals with localStorage, sessionStorage, IndexedDB, cookie, and memory drivers.",
  "type": "module",
  "license": "MIT",
  "author": "Klaus Zahiragic <watzak>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/kamod-signals.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm test && pnpm typecheck && pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "pnpm --dir docs dev",
    "docs:check": "pnpm --dir docs check",
    "docs:build": "pnpm --dir docs build",
    "docs:preview": "pnpm --dir docs preview"
  },
  "peerDependencies": {
    "@preact/signals": "^2.0.0",
    "preact": "^10.0.0"
  },
  "devDependencies": {
    "@preact/signals": "^2.9.2",
    "@types/node": "^26.1.0",
    "jsdom": "^29.1.1",
    "preact": "^10.29.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.8.0"
}
